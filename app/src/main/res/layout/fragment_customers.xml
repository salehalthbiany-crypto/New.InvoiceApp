<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العملاء" android:textSize="24sp" android:textStyle="bold" />
        <Button android:id="@+id/addCustomerButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ عميل" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/customersRecycler" android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
